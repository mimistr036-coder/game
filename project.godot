; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]
name="Godot Messenger"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.054902, 0.129412, 0.168627, 1)

[autoload]
ChatManager="*res://scripts/ChatManager.gd"
NetworkManager="*res://scripts/NetworkManager.gd"

[display]
window/size/viewport_width=1200
window/size/viewport_height=800
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.054902, 0.129412, 0.168627, 1)
